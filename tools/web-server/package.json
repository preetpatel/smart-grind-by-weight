{
    "name": "web-server",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "predev": "node scripts/prepare-static.mjs",
        "dev": "next dev",
        "prebuild": "node scripts/prepare-static.mjs",
        "build": "next build",
        "start": "next start",
        "lint": "biome check",
        "lint:fix": "biome check --write",
        "format": "biome format --write",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "db:generate": "drizzle-kit generate"
    },
    "dependencies": {
        "drizzle-orm": "^0.45.2",
        "next": "16.3.0-canary.106",
        "pg": "^8.16.0",
        "react": "19.2.8",
        "react-dom": "19.2.8"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.6",
        "@electric-sql/pglite": "^0.3.6",
        "@types/node": "^26.1.2",
        "@types/pg": "^8.20.3",
        "@types/react": "19.2.18",
        "drizzle-kit": "^0.31.10",
        "typescript": "^5.9.3",
        "vitest": "^3.2.4"
    },
    "packageManager": "pnpm@10.33.2",
    "pnpm": {
        "onlyBuiltDependencies": [
            "esbuild",
            "sharp"
        ]
    }
}
