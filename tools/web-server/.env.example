# Copy to .env.local and fill in — quick start:
#
#   cp .env.example .env.local
#   sed -i '' "s/^BETTER_AUTH_SECRET=.*/BETTER_AUTH_SECRET=$(openssl rand -hex 32)/" .env.local
#
# Full reference: README.md "Environment".

# --- database ---------------------------------------------------------------
# Postgres connection string (any Postgres works: local, docker, Neon, ...).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sgbw

# --- auth (Better Auth) -----------------------------------------------------
# Session-cookie signing secret, >=32 chars. Generate with:
#   openssl rand -hex 32
# Keep it stable — rotating it signs every user out.
BETTER_AUTH_SECRET=

# Canonical origin of the app. Needed for the GitHub OAuth redirect and for
# passkeys to resolve the right relying party.
BETTER_AUTH_URL=http://localhost:3000

# --- GitHub OAuth (optional) ------------------------------------------------
# Enables the "Continue with GitHub" button. Create an OAuth app at
# https://github.com/settings/developers with:
#   Homepage URL:               ${BETTER_AUTH_URL}
#   Authorization callback URL: ${BETTER_AUTH_URL}/api/auth/callback/github
# (GitHub allows one callback per OAuth app — use a separate app per
# environment.) Leave unset to hide the button; email/password and passkeys
# work without it.
#GITHUB_CLIENT_ID=
#GITHUB_CLIENT_SECRET=

# --- sync limits (optional, defaults in lib/config.ts) ----------------------
#SYNC_SESSION_QUOTA=10000
#SYNC_STORES_PER_USER=20
#SYNC_UPLOADS_PER_HOUR=200
#SYNC_MAX_SESSION_BYTES=65536
#SYNC_MAX_SNAPSHOT_BYTES=4096
